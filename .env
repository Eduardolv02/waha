# ===========================================
# WAHA CONFIG (WhatsApp HTTP API)
# ===========================================
WAHA_HTTP_PORT=${PORT}
WAHA_HTTP_NO_AUTH=true
WAHA_LOG_LEVEL=info
WAHA_ZIPPER=ZIPUNZIP
CHOKIDAR_USEPOLLING=1
CHOKIDAR_INTERVAL=5000

# ===========================================
# OPTIONAL SETTINGS
# ===========================================
WAHA_SESSION_DIR=/sessions
WAHA_TMP_DIR=/tmp
NODE_ENV=production
